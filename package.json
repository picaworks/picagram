{
  "name": "pica",
  "version": "0.1.0",
  "private": true,
  "description": "ASCII-first components for React and plain HTML, served in the formats coding agents read.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build:registry": "tsx scripts/build.ts",
    "build:site": "next build",
    "build": "npm run build:registry && npm run build:site",
    "verify": "tsx scripts/verify/index.ts",
    "check:site": "tsx scripts/check-site.ts",
    "brand": "tsx scripts/brand.ts",
    "geo": "tsx scripts/geo.ts",
    "review": "node scripts/review.mjs",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "shadcn": "4.21.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
